    "### 1.1. Ejemplo resuelto: Selección de columnas y tipado explícito\n",
    "\n",
    "En este ejemplo creamos un archivo CSV básico y lo leemos limitando las columnas necesarias y forzando tipos para garantizar la consistencia de los datos."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "e7e838d5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "DataFrame cargado:\n",
      "    id          articulo  precio\n",
      "0  001  Teclado Mecánico    65.5\n",
      "1  002       Ratón Láser    24.9\n",
      "2  003        Monitor 4K   280.0\n",
      "\n",
      "Tipos de datos:\n",
      "id              str\n",
      "articulo        str\n",
      "precio      float64\n",
      "dtype: object\n"
     ]
    }
   ],
   "source": [
    "import pathlib\n",
    "import pandas as pd\n",
    "\n",
    "pathlib.Path(\"data_sample\").mkdir(exist_ok=True)\n",
    "ruta_demo = \"data_sample/ejemplo_basico.csv\"\n",
    "\n",
    "# 1. Creamos un CSV de demostración\n",
    "pd.DataFrame({\n",
    "    \"id\": [\"001\", \"002\", \"003\"],\n",
    "    \"articulo\": [\"Teclado Mecánico\", \"Ratón Láser\", \"Monitor 4K\"],\n",
    "    \"precio\": [65.50, 24.90, 280.00],\n",
    "    \"stock\": [15, 40, 8]\n",
    "}).to_csv(ruta_demo, sep=\";\", index=False, encoding=\"utf-8\")\n",
    "\n",
    "# 2. Lectura selectiva con usecols y dtype\n",
    "df_demo = pd.read_csv(\n",
    "    ruta_demo,\n",
    "    sep=\";\",\n",
    "    usecols=[\"id\", \"articulo\", \"precio\"],\n",
    "    dtype={\"id\": str, \"precio\": float}\n",
    ")\n",
    "\n",
    "print(\"DataFrame cargado:\")\n",
    "print(df_demo)\n",
    "print(\"\\nTipos de datos:\")\n",
    "print(df_demo.dtypes)"
   ]
