    "ruta_demo_eur = \"data_sample/ejemplo_europeo.csv\"\n",
    "\n",
    "# Datos de partida\n",
    "l1 = \"producto;precio;estado\\n\"\n",
    "l2 = \"Portátil;899,95;disponible\\n\"\n",
    "l3 = \"Móvil;249,50;N/D\\n\"\n",
    "l4 = \"Auriculares;19,99;disponible\\n\"\n",
    "matriz = [l1, l2, l3, l4]\n",
    "\n",
    "separador = ','\n",
    "cod = 'latin-1'\n",
    "\n",
    "# Limpieza\n",
    "for i in range(len(matriz)):\n",
    "    fila_limpia = matriz[i][0:-1].split(separador)\n",
    "    matriz[i] = fila_limpia\n",
    "\n",
    "pd.DataFrame(matriz).to_csv(ruta_demo_eur, sep=separador, index=False, encoding=cod)\n",
    "print(matriz)\n",
    "\n",
    "\n",
    "# Leemos indicando encoding, separador decimal y lista de valores nulos\n",
    "df_eur = pd.read_csv(\n",
    "    ruta_demo_eur,\n",
    "    sep=separador,\n",
    "    decimal=\",\",\n",
    "    encoding=cod,\n",
    "    na_values=[\"N/D\"],\n",
    "    skiprows=1,\n",
    "    usecols= ['precio']\n",
    ")\n",
    "\n",
    "print(df_eur)\n",
    "print(\"\\nTipo de columna precio:\", df_eur[\"precio\"].dtype)\n",
    "print(\"Valores nulos por columna:\\n\", df_eur.isna().sum())"
   ]
  },
