    "    )\n",
    "\n",
    "# 2. clientes_padron.csv (identificadores con ceros a la izquierda y nulos sucios)\n",
    "with open(\"data_sample/clientes_padron.csv\", \"w\", encoding=\"utf-8\") as f:\n",
    "    f.write(\n",
    "        \"id_cliente,nombre,codigo_postal,email,edad\\n\"\n",
