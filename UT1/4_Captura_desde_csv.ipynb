    "    f.write(\n",
    "        \"id_transaccion;fecha;cliente;precio\\n\"\n",
    "        \"TX101;05/02/2024;TechCorp;1500.00\\n\"\n",
    "        \"TX102;12/07/2024;BioHealth;2300.50\\n\"\n",
    "        \"TX103;20/11/2024;GlobalLogistics;850.00\\n\"\n",
    "        \"TX104;15/01/2025;TechCorp;3200.00\\n\"\n",
    "        \"TX105;28/04/2025;RetailPlus;450.75\\n\"\n",
    "    )\n",
    "\n",
    "# 5. ventas_tiendas.csv (ventas por categoría y tienda para agregaciones)\n",
